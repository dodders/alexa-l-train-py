# MTA API Configuration
# NOTE: As of 2024, MTA APIs no longer require authentication!
# The API is free and open to use without registration.

# MTA API Endpoint URL (default is L train)
# Other lines available:
#   gtfs-123456 = 1, 2, 3, 4, 5, 6 trains
#   gtfs-l = L train
#   gtfs-ace = A, C, E trains
#   gtfs-nqrw = N, Q, R, W trains
#   gtfs-bdfm = B, D, F, M trains
#   gtfs-g = G train
#   gtfs-jz = J, Z trains
#   gtfs-7 = 7 train
#   gtfs-si = Staten Island Railway
MTAURL=https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/nyct%2Fgtfs-l

# Alexa Skill ID
# Find this in your Alexa Developer Console under Skill ID
ALEXA_SKILL_ID=amzn1.ask.skill.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# AWS Profile (optional - defaults to 'serverless' in serverless.yml)
# AWS_PROFILE=serverless
